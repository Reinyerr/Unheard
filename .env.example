# Copy to backend/.env for FastAPI/TTS. Never put secrets in VITE_ variables.
UNHEARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local ZIP or exact extracted pack root. For the audit, use --source or export
# this variable in the shell; the standard-library audit does not load .env.
UNHEARD_DATA_ROOT=
# Server-only. T-008 CLI reads the exported shell environment, not this file.
# Never pass a real key as a CLI argument or put it in VITE_ variables.
ELEVENLABS_API_KEY=
# T-015 non-secret defaults; shared/tts_prompts.json is the matching UI catalog.
# Copy server settings to backend/.env; never copy the API key to React.
# No voice/model fallback. Different IDs fail closed until the catalog is reviewed.
ELEVENLABS_TTS_MODEL_ID=eleven_v3
ELEVENLABS_TTS_VOICE_URDU=vH5LP38dcYJ3CIbC2rKX
ELEVENLABS_TTS_VOICE_PUNJABI=z0HCBc2pw7Mdq6koP5os
ELEVENLABS_TTS_VOICE_CANTONESE=OjkyUe8dIihIFvOisuvM
ELEVENLABS_TTS_VOICE_ARABIC=Hvlnv5DwiIO2CQ6oYMZ3
ELEVENLABS_TTS_VOICE_MANDARIN_CHINESE=4NQthjVhIGGVfL3Si000
ELEVENLABS_TTS_VOICE_ENGLISH=6FiCmD8eY5VyjOdG5Zjk
